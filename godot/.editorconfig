root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.gd]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
max_line_length = 150
insert_final_newline = false
gdscript_formatter_blank_lines_around_definitions = 2
gdscript_formatter_continuation_indent_level = 4
gdscript_formatter_indent_blank_lines = false